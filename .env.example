# Copy to backend/.env for local development. Never commit real secrets.
# For local development, a SQLite database is used by default. Set DATABASE_URL
# to a PostgreSQL URL in production, e.g. postgresql+psycopg://fs:fs@localhost:5432/familyshield

DATABASE_URL=sqlite:///./familyshield_dev.db
SECRET_KEY=replace-with-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. When set, natural-language explanations are generated with Groq.
# When missing, the built-in deterministic explanation engine is used and labeled in the response.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. When set, URLs are checked against Google Safe Browsing.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional active URL probe. Disabled by default for safety.
# TLS certificate inspection uses a socket/TLS handshake only; it never downloads page content or scripts.
SAFE_URL_PROBE=false
TLS_PROBE_TIMEOUT_SECONDS=1.5

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=20
FRONTEND_BASE_URL=http://localhost:5173

# Development convenience: auto-create tables on startup for SQLite.
# Set to false in production and run `alembic -c backend/alembic.ini upgrade head`.
DEV_AUTO_CREATE_TABLES=true

# Frontend: copy to frontend/.env
# VITE_API_URL=http://localhost:8000
